---
/* Dusk link cards: whole block clickable, radius 12, padding 24, at most one accent card per row. */
import { ArrowUpRight } from '@lucide/astro';
import { community } from '../content/site';
import Icon from './Icon.astro';
import SectionIntro from './SectionIntro.astro';
---

<section class="ds-section" id="community">
  <div class="ds-container">
    <SectionIntro eyebrow={community.eyebrow} title={community.title} copy={community.copy} />
    <ul class="ds-grid ds-grid--3">
      {community.cards.map((card) => (
        <li>
          <a
            class:list={['card', { 'card--accent': card.accent }]}
            href={card.href}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="title">
              <Icon name={card.icon} />
              {card.title}
              <ArrowUpRight class="external" size={14} stroke-width={2} aria-hidden="true" />
            </span>
            <span class="text">{card.text}</span>
            <span class="ds-sr-only">(opens in a new tab)</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  li {
    display: flex;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    width: 100%;
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: var(--surface-card);
    transition:
      background-color var(--motion-duration-fast) var(--motion-easing-standard),
      translate var(--motion-duration-fast) var(--motion-easing-standard);
  }

  .card:hover {
    background: var(--surface-card-hover);
  }

  .card:focus-visible {
    border-radius: var(--radius-lg);
  }

  .title {
    display: flex;
    align-items: center;
    gap: var(--space-2-5);
    font-size: var(--font-size-body-l);
    font-weight: var(--font-weight-medium);
    color: var(--text-heading);
  }

  .title :global(.external) {
    margin-left: auto;
  }

  .text {
    font-size: var(--font-size-label);
    line-height: var(--font-line-height-relaxed);
    color: var(--text-muted);
  }

  .card--accent {
    background: var(--accent-primary);
  }

  .card--accent:hover {
    background: var(--accent-primary-hover);
  }

  .card--accent .title,
  .card--accent .text {
    color: var(--text-on-accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .card:hover {
      translate: 0 var(--motion-distance-hover-lift);
    }
  }
</style>
