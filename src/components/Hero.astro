---
/* Dusk hero A: eyebrow → H1 on two lines (second in accent) → lead → 2 CTA → meta, illustration on the side. */
import { hero } from '../content/site';
import Button from './Button.astro';

const separated = (items: readonly string[]) =>
  items.flatMap((item, i) => (i === 0 ? [item] : [null, item]));
---

<section class="hero">
  <div class="ds-container grid">
    <div class="text">
      <p class="ds-eyebrow ds-rise">
        {separated(hero.eyebrow).map((item) =>
          item === null ? (
            <span class="ds-sep" aria-hidden="true">
              ·
            </span>
          ) : (
            <span>{item}</span>
          ),
        )}
      </p>
      <h1 class="ds-display-l ds-rise" style="--delay: 80ms">
        {hero.titleLine}
        <br />
        <span class="ds-text-accent">{hero.titleAccent}</span>
      </h1>
      <p class="ds-lead ds-rise" style="--delay: 160ms">
        {hero.lead}
      </p>
      <div class="ds-btn-row ds-rise" style="--delay: 240ms">
        <Button href={hero.primary.href} variant="primary" size="xl">
          {hero.primary.label}
        </Button>
        <Button href={hero.secondary.href} variant="secondary" size="xl">
          {hero.secondary.label}
        </Button>
      </div>
      <p class="meta ds-rise" style="--delay: 320ms">
        {separated(hero.meta).map((item) =>
          item === null ? (
            <span class="ds-sep" aria-hidden="true">
              ·
            </span>
          ) : (
            <span>{item}</span>
          ),
        )}
      </p>
    </div>

    <div class="media ds-rise" style="--delay: 200ms" aria-hidden="true">
      <canvas data-sunset></canvas>
    </div>
  </div>
</section>

<script>
  import { mountSunset } from '../scripts/pixel-sunset';

  const canvas = document.querySelector<HTMLCanvasElement>('[data-sunset]');
  if (canvas) mountSunset(canvas, { horizon: 0.78, sunX: 0.62, sunR: 0.16 });
</script>

<style>
  .hero {
    padding-top: calc(var(--size-header) + var(--space-12));
    padding-bottom: var(--section-py-mobile);
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-12);
    align-items: center;
  }

  /* display-l is sized in cqi: the text column is its container */
  .text {
    container-type: inline-size;
  }

  h1 {
    margin-top: var(--space-5);
  }

  .ds-lead {
    margin-top: var(--space-6);
  }

  .ds-btn-row {
    margin-top: var(--space-8);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-6);
    font-size: var(--font-size-label);
    color: var(--text-subtle);
  }

  /* Media card: radius 16 + 1px ring, no shadow. The gradient shows until the canvas has painted. */
  .media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: var(--radius-xl);
    background: var(--gradient-brand);
    box-shadow: var(--shadow-ring-card);
  }

  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    image-rendering: pixelated;
    opacity: 0;
    transition: opacity var(--motion-duration-slow) var(--motion-easing-out);
  }

  canvas:global(.is-ready) {
    opacity: 1;
  }

  @media (min-width: 64rem) {
    .hero {
      display: flex;
      align-items: center;
      min-height: 100svh;
      padding-top: calc(var(--size-header) + var(--space-16));
      padding-bottom: var(--space-16);
    }

    .grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 26rem);
      gap: var(--space-16);
    }

    .media {
      aspect-ratio: 4 / 5;
    }
  }
</style>
